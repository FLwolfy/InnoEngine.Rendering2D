// u_bloom.x is scatter; u_texelSize.xy belongs to the lower-resolution source.
vec4 Evaluate(vec2 uv, sampler2D s_source, sampler2D s_auxiliary, vec4 u_texelSize, vec4 u_bloom)
{
    vec4 highFrequency = texture2D(s_auxiliary, uv);
    vec3 lowFrequency = vec3(0.0);
    lowFrequency += texture2D(s_source, uv + vec2(-1.0, -1.0) * u_texelSize.xy).rgb;
    lowFrequency += texture2D(s_source, uv + vec2( 1.0, -1.0) * u_texelSize.xy).rgb;
    lowFrequency += texture2D(s_source, uv + vec2(-1.0,  1.0) * u_texelSize.xy).rgb;
    lowFrequency += texture2D(s_source, uv + vec2( 1.0,  1.0) * u_texelSize.xy).rgb;
    return vec4(highFrequency.rgb + lowFrequency * (0.25 * u_bloom.x), highFrequency.a);
}
