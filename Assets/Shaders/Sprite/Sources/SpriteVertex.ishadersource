// Instance-space Sprite geometry only; no Pipeline-internal operation tags.
void Evaluate(vec2 a_position, vec4 i_data0, vec4 i_data1, vec4 i_data2, vec4 i_data3, vec4 i_data4, mat4 viewProjection, vec3 vertexOffset,
    out vec4 position, out vec2 v_texcoord0, out vec4 v_color0, out float v_shape, out vec2 v_effectStep)
{
    vec2 worldPosition = i_data0.xy
        + a_position.x * (i_data0.zw - i_data0.xy)
        + a_position.y * (i_data1.xy - i_data0.xy);
    vec2 uv = i_data1.zw
        + a_position.x * (i_data2.xy - i_data1.zw)
        + a_position.y * (i_data2.zw - i_data1.zw);
    position = mul(viewProjection, vec4(worldPosition + vertexOffset.xy, i_data3.x + vertexOffset.z, 1.0));
    v_texcoord0 = uv;
    v_color0 = i_data4;
    v_shape = i_data3.y;
    v_effectStep = i_data3.zw;
}
